# =================================================================
# TELEGRAM API CREDENTIALS (from https://my.telegram.org)
# =================================================================
API_ID=12345678
API_HASH=your_telegram_api_hash_here
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Secondary bot tokens for Multi-Client bandwidth acceleration (comma-separated, optional)
MULTI_TOKENS=

# =================================================================
# STORAGE & LOGGING
# =================================================================
# ID of a private Telegram channel where the bot is an Admin (e.g. -1001234567890)
BIN_CHANNEL=-1001234567890

# Bot Owner's Telegram User ID
OWNER_ID=123456789

# =================================================================
# SERVER & NETWORK SETTINGS
# =================================================================
PORT=8080
BIND_ADDRESS=0.0.0.0

# Backend Server Origin URL (e.g., http://localhost:8080 or https://your-domain.com)
SERVER_URL=http://localhost:8080

# Cloudflare Worker Domain (optional, for https://dl.yourname.workers.dev)
# If provided, generated links will use this domain instead of SERVER_URL
WORKER_URL=https://dl.yourname.workers.dev

# =================================================================
# BRANDING & UPDATES
# =================================================================
UPDATES_CHANNEL=
HASH_PREFIX=stream-
DATABASE_URL=stream_bot.db

